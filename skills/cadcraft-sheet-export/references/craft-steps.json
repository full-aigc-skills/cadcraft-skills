{
  "schema": "craft-scenario-playbooks/v1",
  "application": "cadcraft",
  "id": "sheet-export",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "确认当前单位为毫米；不是毫米时先确认，不能只改单位变量冒充转换",
      "command": "getvar",
      "params": {
        "name": "INSUNITS"
      }
    },
    {
      "purpose": "核对图纸内容范围",
      "command": "drawing.inspect",
      "params": {
        "entities": false
      }
    },
    {
      "purpose": "测量用于纸面校核的基准",
      "command": "dist",
      "params": {
        "p1": [
          0,
          0
        ],
        "p2": [
          5000,
          0
        ]
      }
    },
    {
      "purpose": "量取第二个垂直基准，避免只校核一个方向",
      "command": "dist",
      "params": {
        "p1": [
          0,
          0
        ],
        "p2": [
          0,
          4000
        ]
      }
    },
    {
      "purpose": "按纸张与比例出图",
      "command": "plot",
      "params": {
        "path": "output/sheet.pdf",
        "layout": "Model",
        "paper": "A4",
        "scale": "1:50",
        "fit": false,
        "lineweights": true,
        "landscape": false,
        "center": true,
        "compress": false
      }
    }
  ],
  "check": "核对PDF实际A4页面，以及5000/4000毫米模型基准在纸面为100/80毫米；复查打印裁切、文字和线宽。原图坐标与文件保持不变。",
  "boundary": "打印比例不是模型缩放，也不是DIMSCALE。非毫米图先确认实际单位转换；fit=true会覆盖固定比例意图。纸张/比例不合适时与用户确认，不暗中缩小。compress=false仅让此检查样例PDF内容可读，不改变几何。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。",
  "inputs": "已确认毫米单位的模型图；基准水平5000mm、垂直4000mm。A4纵向、1:50、居中、不自动适应。"
}
