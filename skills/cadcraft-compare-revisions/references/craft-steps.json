{
  "schema": "craft-scenario-playbooks/v1",
  "application": "cadcraft",
  "id": "compare-revisions",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "与第二版图纸建立几何比较",
      "command": "compare",
      "params": {
        "path": "input/revision-b.dxf"
      }
    },
    {
      "purpose": "逐区域查看差异",
      "command": "compare.next",
      "params": {}
    },
    {
      "purpose": "结束比较后保留工作图",
      "command": "compareclose",
      "params": {}
    }
  ],
  "check": "检查 added/removed/changed 与区域；排除单位和坐标原点差异。",
  "boundary": "比较前先打开A版；不按内部句柄单独判定几何是否相同。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
